# ── Alpaca ────────────────────────────────────────────────────────────────────
ALPACA_KEY=YOUR_KEY_HERE
ALPACA_SECRET=YOUR_SECRET_HERE

# Safety: paper=true by default. Set REAL_TRADING=true ONLY for live money.
REAL_TRADING=false

# ── Email ─────────────────────────────────────────────────────────────────────
GMAIL_USER=arbaiza.erik@gmail.com
GMAIL_APP_PASSWORD=YOUR_APP_PASSWORD_HERE
EMAIL_TO=arbaiza.erik@gmail.com

# ── Strategy ──────────────────────────────────────────────────────────────────
# Budget to deploy (0 = use full account equity)
DEPLOY_BUDGET=0

# Minimum buy trades a politician must have in the last 12 months to be ranked
MIN_TRADES=3

# Maximum open positions to mirror
MAX_POSITIONS=10

# ── Risk controls ─────────────────────────────────────────────────────────────
# Maximum % of portfolio per single position (0.05 = 5%)
MAX_POSITION_PCT=0.05

# Maximum % of portfolio allocated to one sector (0.20 = 20%)
MAX_SECTOR_PCT=0.20

# Minimum stock price — filters out penny stocks
MIN_PRICE=5.0

# Minimum average daily volume (shares) — 0 to disable
MIN_VOLUME=40000

# Stop-loss: close position if it drops this % below entry (0 to disable)
STOP_LOSS_PCT=0.10

# Take-profit: close position if it rises this % above entry (0 to disable)
TAKE_PROFIT_PCT=0.30
